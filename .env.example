# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then replace placeholder values with real keys.

LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile

# domain_assistant.py rotates across these keys to reduce rate-limit failures.
GROQ_API_KEY_1=gsk_your_groq_key_1_here
GROQ_API_KEY_2=gsk_your_groq_key_2_here
GROQ_API_KEY_3=gsk_your_groq_key_3_here
GROQ_API_KEY_4=gsk_your_groq_key_4_here

# Optional fallback if you set LLM_PROVIDER=openai.
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
